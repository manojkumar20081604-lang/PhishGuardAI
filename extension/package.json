{
  "name": "phishguard-extension",
  "version": "3.2.0",
  "description": "PhishGuard AI - Browser Extension for Phishing Detection",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "build:chrome": "vite build --mode production",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,html,css,json}\"",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:chrome && npm run build:firefox"
  },
  "keywords": [
    "phishing",
    "security",
    "browser-extension",
    "manifest-v3"
  ],
  "author": "PhishGuard AI",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.4.9",
    "@types/chrome": "^0.0.254",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.56.0",
    "onnxruntime-node": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "prettier": "^3.2.0",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 88",
    "firefox >= 78",
    "edge >= 88"
  ]
}
